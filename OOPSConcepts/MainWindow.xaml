<Window x:Class="OOPSConcepts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOPSConcepts"
        mc:Ignorable="d"
        Title="OOP Concepts Practice"
        Height="960" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#FFF4F8">

    <Grid Margin="25">
        <Border Background="White"
                CornerRadius="20"
                Padding="25"
                BorderBrush="#F3C4D8"
                BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="C# FUNDAMENTALS"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#C2185B"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="OOP Concepts Practice"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#880E4F"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,5"/>

                    <TextBlock Text="Learn Object-Oriented Programming with C#"
                               FontSize="14"
                               Foreground="#777777"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,22"/>

                    <Border Background="#FFF0F6"
                            CornerRadius="12"
                            Padding="18"
                            Margin="0,0,0,15">

                        <StackPanel>
                            <TextBlock Text="EMPLOYEE DETAILS"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#AD1457"
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="Employee Name"
                                       FontWeight="SemiBold"/>

                            <TextBox x:Name="NameTextBox"
                                     Text="Hema"
                                     Height="38"
                                     Padding="10"
                                     Margin="0,5,0,12"/>

                            <TextBlock Text="Employee ID"
                                       FontWeight="SemiBold"/>

                            <TextBox x:Name="IdTextBox"
                                     Text="101"
                                     Height="38"
                                     Padding="10"
                                     Margin="0,5,0,12"/>

                            <TextBlock Text="Monthly Salary"
                                       FontWeight="SemiBold"/>

                            <TextBox x:Name="SalaryTextBox"
                                     Text="30000"
                                     Height="38"
                                     Padding="10"
                                     Margin="0,5,0,12"/>

                            <TextBlock Text="Employee Type"
                                       FontWeight="SemiBold"/>

                            <ComboBox x:Name="EmployeeTypeComboBox"
                                      Height="38"
                                      Padding="8"
                                      SelectedIndex="0"
                                      Margin="0,5,0,15">
                                <ComboBoxItem Content="Developer"/>
                                <ComboBoxItem Content="Manager"/>
                            </ComboBox>

                            <Button Content="Demonstrate OOP Concepts"
                                    Height="45"
                                    Background="#D81B60"
                                    Foreground="White"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="ShowDetails_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8F0FF"
                            CornerRadius="12"
                            Padding="18"
                            Margin="0,0,0,15">

                        <StackPanel>
                            <TextBlock Text="OUTPUT"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#7B1FA2"
                                       Margin="0,0,0,10"/>

                            <TextBlock x:Name="OutputTextBlock"
                                       Text="Enter employee details and click the button."
                                       FontSize="14"
                                       Foreground="#4A148C"
                                       TextWrapping="Wrap"
                                       LineHeight="25"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFF8E1"
                            CornerRadius="12"
                            Padding="18">

                        <StackPanel>
                            <TextBlock Text="OOP CONCEPTS"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#8D6E00"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="1. Encapsulation - Salary is managed through a property."
                                       TextWrapping="Wrap"
                                       Margin="0,4"/>

                            <TextBlock Text="2. Inheritance - Developer and Manager inherit Employee."
                                       TextWrapping="Wrap"
                                       Margin="0,4"/>

                            <TextBlock Text="3. Polymorphism - Each employee provides different details."
                                       TextWrapping="Wrap"
                                       Margin="0,4"/>

                            <TextBlock Text="4. Abstraction - Employee defines an abstract method."
                                       TextWrapping="Wrap"
                                       Margin="0,4"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="C# Fundamentals | OOP Practice"
                               Foreground="#999999"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0"/>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>

